# Copiá a panel/.env.local. Nunca commitear valores: el repo es público.

# Supabase (el navegador los ve: solo URL y clave anon/publishable)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (lib/supabase/admin.ts, usado desde app/api/**). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Zona del negocio para fechas y horas del panel
NEGOCIO_TZ=America/Argentina/Cordoba

# Opcional: ruta al generador del prompt (por defecto ../scripts/armar-prompt.mjs, hito 1.3 de agente)
ARMAR_PROMPT_SCRIPT=

# Mail de invitación al panel (decisión de Mateo, 17/9). Solo servidor, nunca con prefijo
# NEXT_PUBLIC_. Sin esto, invitar sigue funcionando igual (pre-aprueba en silencio, sin mail).
RESEND_API_KEY=
# URL pública del panel, para el link del mail de invitación. Sin esto, el mail sale igual pero
# sin link (con "entrá al panel de Otto Su Misura" a secas).
PANEL_URL=
