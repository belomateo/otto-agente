# Copiá a .env (raíz, para Supabase CLI) y a panel/.env.local (para Next). Nunca commitear valores.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=              # conexión directa a Postgres, solo para migraciones/tests/scripts

# OpenAI — los modelos se eligen por tarea, nunca hardcodeados
OPENAI_API_KEY=
LLM_PRINCIPAL=
LLM_CLASIFICADOR=
LLM_EXTRACTOR=
# LLM_TRANSCRIPCION: modelo de /v1/audio/transcriptions (pedido de Mateo, 19/9: que Lucía lea
# audios). Sin esto, transcribir() manda model="" y la API lo rechaza — falta setearlo en el
# entorno real antes de que el worker con descarga de medios esté en producción.
LLM_TRANSCRIPCION=

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Google Calendar (cuenta de servicio, JSON en base64)
# EN PAUSA (decision #13): la agenda es propia, _shared/agenda/calendario_propio.ts.
# Estas dos no las lee nadie hoy; quedan para si Calendar vuelve.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Worker (las tres las lee supabase/functions/worker)
# WORKER_SECRET: el secreto de la cabecera x-worker-secret; sin esto el worker contesta 403.
WORKER_SECRET=
# LUCIA_TELEFONOS: a quién le contesta Lucía. Números en formato de Meta separados por coma,
# «*» para todos (producción), vacío para nadie. Los teléfonos ficticios de prueba
# (5490000000…) le contestan siempre, estén o no en la lista.
LUCIA_TELEFONOS=
# CRONS_ENVIOS: «on» prende los envíos por plantilla. Apagado hasta que Meta las apruebe.
CRONS_ENVIOS=

# Negocio
NEGOCIO_TZ=America/Argentina/Cordoba
# Los links (resena, maps, catalogo) NO son variables de entorno: viven en la tabla
# `enlaces` y se editan desde Configuracion > Enlaces. Los resuelve enlaceDeTipo().
DERIVACION_ALQUILER_TEL=
